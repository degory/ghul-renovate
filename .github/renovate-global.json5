{
  // Renovate configuration for the instance the workflow beside this file
  // runs. It describes the instance rather than this repository, so it lives
  // under .github/ and is named distinctly: a repository-level renovate.json
  // would be read as configuration for updating this repository alone, which
  // is the opposite of what it is for.

  // These have to form a chain and never a cycle. An update landing in one
  // publishes a package, and publishing a package is what prompts the next
  // update, so a repository that ends up building against something it
  // published would hand updates back and forth indefinitely, every round
  // producing a real new version.
  //
  // A chain is fine because it ends. ghul-test publishes ghul.test, which
  // ghul-examples builds against, and ghul-examples publishes nothing, so that
  // one stops there.
  //
  // ghul is in the middle of two of them, and is here anyway, because a cycle
  // only runs by itself if every edge in it is automatic - so it is enough to
  // leave one edge of each to a person, and it does not have to be the edge
  // anyone cares about. The two cycles, and where each is cut, are in the
  // package rules at the foot of this file. What that buys is the thing the
  // exclusion was costing: the compiler drifted two majors behind the runtime,
  // and what that hid was not a stale version number but a crash - one call
  // site that killed the compiler outright on source anyone could write.
  //
  // ghul-runtime stays out, and is now the cut in the cycle it shares with
  // ghul: its compiler pin moves when a runtime change needs a newer compiler,
  // which is a judgement rather than a version comparison. Automating both
  // ends of that pair is what would run away.
  repositories: [
    'degory/ghul',
    'degory/ghul-templates',
    'degory/ghul-repository-template',
    'degory/ghul-examples',
    'degory/ghul-dev',
    'degory/ghul-mcp',
    'degory/ghul-vsce',
    'degory/ghul-debug',
    'degory/ghul-code-review',
    'degory/ghul-web-api',
    'degory/ghul-test',
    'degory/ghul-playground',

    // Itself, so the actions its own workflow pins stay current. It publishes
    // nothing and nothing builds against it, so it cannot be part of a loop.
    'degory/ghul-renovate',
  ],

  // None of them carries a renovate.json, and none needs one: this file is the
  // single place the behaviour is described. Without these two settings
  // Renovate would instead open a pull request in each of them offering to add
  // one.
  onboarding: false,
  requireConfig: 'optional',

  dependencyDashboard: true,

  // Every target repository's CI builds what it depends on and runs the
  // result, so a version that breaks it fails the checks and the pull request
  // stays open. That gate is what makes merging without review reasonable
  // here, including across major versions - the ghūl compiler reaches a new
  // major often, and a repository pinned to an old one is the problem this is
  // meant to solve.
  //
  // Set here rather than against particular managers, because what makes
  // automerging safe is that the checks have to pass, which holds however the
  // dependency was found. Restricted to NuGet and actions it left npm updates
  // with no automerge at all, and a pull request nothing will ever merge just
  // sits there.
  //
  // Branch protection still applies: where a CODEOWNERS entry covers
  // .github/workflows, an action update waits for that review. Automerge stays
  // armed and lands it once the review arrives.
  automerge: true,

  // A merged pull request's body becomes the release description in the
  // repository it updated, so the body carries only what describes the change:
  // which packages moved and to what. The default template also appends how to
  // interact with Renovate itself - its schedule, whether it automerges, when
  // it rebases, and a checkbox to request one - which is addressed to whoever
  // is reviewing the pull request and means nothing to someone reading the
  // release afterwards.
  prBodyTemplate: '{{{header}}}{{{table}}}{{{warnings}}}{{{notes}}}',

  // A dependency's changelog belongs in that dependency's releases, not
  // reproduced in the body of every pull request that bumps it. The table
  // already links each package to its source and to the comparison between the
  // versions, which is what a reader following up actually wants.
  //
  // Reproducing them did not fit either. A span of ghūl releases, like any one
  // third-party changelog, runs past the length the platform will store, so the
  // body was truncated - and what shipped as the release description ended
  // mid-sentence somewhere inside another project's release notes.
  fetchChangeLogs: 'off',

  // The classlib tests reference the package the template itself builds, which
  // is produced locally and never published, so looking it up finds nothing.
  ignoreDeps: ['example.classlib'],

  // A .ghulproj is not an extension any updater recognises, and nearly no ghūl
  // project declares package versions in one: they come from the
  // Directory.Build.props and Directory.Packages.props beside it, and the
  // nuget manager reads .props files directly, as it reads the pinned compiler
  // in .config/dotnet-tools.json. So the ghūl projects need no special
  // handling here - except ghul-playground, which is the one that has no
  // .props file and writes its runtime version into the .ghulproj itself.
  //
  // That repository writes the compiler and runtime versions in five places
  // rather than one, because two of them are container images that install the
  // versions rather than restoring them. All five have to move together: the
  // services compile user code against one runtime and the browser loads
  // another, so a version left behind is a program that compiles, downloads,
  // and then fails to load. Its CI checks that the five agree, so a partial
  // update fails rather than deploying - but only these managers make the
  // update whole in the first place.
  customManagers: [
    {
      // The two service images install the compiler by version rather than
      // restoring it from a project, so the version is a build argument and no
      // manager sees it. One entry per package rather than one matching both:
      // the package a match belongs to would otherwise have to be derived from
      // the text that matched.
      customType: 'regex',
      managerFilePatterns: ['/(^|/)(compile|analyse)-service/Dockerfile$/'],
      matchStrings: ['ARG GHUL_COMPILER_VERSION=(?<currentValue>\\S+)'],
      depNameTemplate: 'ghul.compiler',
      datasourceTemplate: 'nuget',
    },
    {
      customType: 'regex',
      managerFilePatterns: ['/(^|/)(compile|analyse)-service/Dockerfile$/'],
      matchStrings: ['ARG GHUL_RUNTIME_VERSION=(?<currentValue>\\S+)'],
      depNameTemplate: 'ghul.runtime',
      datasourceTemplate: 'nuget',
    },
    {
      // The runner names its runtime in the .ghulproj itself, there being no
      // Directory.Packages.props beside it to carry the version.
      customType: 'regex',
      managerFilePatterns: ['/(^|/)runner/runner\\.ghulproj$/'],
      matchStrings: [
        '<PackageReference Include="(?<depName>ghul\\.runtime)" Version="(?<currentValue>[^"]+)"',
      ],
      datasourceTemplate: 'nuget',
    },
    {
      // The language server is installed from a ghul-vsce release asset rather
      // than from a registry, so the version is a build argument and the URL
      // beneath it is built from the same argument.
      customType: 'regex',
      managerFilePatterns: ['/(^|/)analyse-service/Dockerfile$/'],
      matchStrings: [
        'ARG GHUL_LANGUAGE_SERVER_VERSION=(?<currentValue>\\S+)',
      ],
      depNameTemplate: 'degory/ghul-vsce',
      datasourceTemplate: 'github-releases',
      extractVersionTemplate: '^v(?<version>.*)$',
    },
  ],

  packageRules: [
    {
      // One pull request for the ghūl packages together rather than one each.
      // Merging any of these publishes a new package, and a run of separate
      // merges publishes a burst of them, which NuGet rate limits.
      //
      // Not restricted by manager: a ghūl package can be pinned in more than
      // one kind of place in the same repository - the playground has its
      // compiler and runtime in the tool manifest and a .csproj, which the
      // nuget manager reads, and also in two Dockerfiles and a .ghulproj,
      // which only the custom regex managers read. Naming the nuget manager
      // here grouped only the first set, so a bump moved the manifest and left
      // the Dockerfiles behind, and the repository's own check that the pins
      // agree failed the build. All of a package's occurrences have to move
      // together, which means all of its managers have to be in one group.
      matchPackageNames: ['/^ghul\\./'],
      groupName: 'ghūl packages',
    },
    {
      // Everything else a repository depends on, in one pull request rather
      // than one per package. Not restricted by manager: these repositories
      // between them carry npm packages, container images and devcontainer
      // features as well as NuGet ones, and a rule that named managers would
      // silently leave out whichever was added next.
      matchPackageNames: ['!/^ghul\\./'],
      groupName: 'dependencies',
    },
    {
      // One pull request for a repository's action updates together rather
      // than one each. Where a CODEOWNERS entry covers .github/workflows an
      // action update needs a review, and grouping asks for one review per run
      // instead of one per action.
      matchManagers: ['github-actions'],
      groupName: 'workflow actions',
    },
    {
      // FluentAssertions 8 replaces the Apache-2.0 licence with a commercial
      // one, and its assertion classes dropped the single-argument
      // constructors ghul-test's wrappers call, so the major does not compile
      // regardless of licence. The library is leaving with the MSTest 4
      // migration; until that lands, hold updates to the last
      // Apache-licensed line so no repository is offered 8.x again.
      matchPackageNames: ['FluentAssertions'],
      allowedVersions: '<8.0.0',
    },

    // The three rules below are what let ghul be updated here at all. They
    // come last because a later rule wins, and each one overrides the grouping
    // above for a single package in a single repository.
    {
      // ghul pins the ghul.compiler it publishes, in its own tool manifest, so
      // left alone this rule's absence would have Renovate update the
      // repository against its own output: merge, publish, offer the version
      // just published, forever, with no second repository involved. The
      // tightest loop available and the only one that needs no cycle to run.
      //
      // Nothing is lost by ignoring it. The pin is a local-dev fallback so
      // that `dotnet tool restore` has a compiler at all; CI resolves the
      // bootstrap compiler at run time and never reads it.
      matchRepositories: ['degory/ghul'],
      matchPackageNames: ['ghul.compiler'],
      enabled: false,
    },
    {
      // The edge this whole change exists for, and the automatic one: the
      // compiler tracks the runtime. Merging publishes a compiler, and the
      // repository that would react to that is ghul-runtime, whose own pin is
      // moved by a person - so this stops after one step.
      //
      // Its own group, because the rule below has to be able to not automerge
      // without dragging this one along: automerge is decided per pull
      // request, so two packages sharing a group share a verdict.
      matchRepositories: ['degory/ghul'],
      matchPackageNames: ['ghul.runtime'],
      groupName: 'ghul.runtime',
      automerge: true,
    },
    {
      // The cut in the other cycle. ghul publishes ghul.compiler, ghul-test
      // updates itself against it and publishes ghul.test, and ghul builds
      // against that - which arrives back here. Raising the pull request is
      // useful; merging it without anyone looking is what would close the
      // ring, so the update is offered and waits.
      //
      // A fair place to stop, because the runner's version is the one that
      // affects nothing shipped: it decides how the tests are run, not what
      // the compiler emits.
      matchRepositories: ['degory/ghul'],
      matchPackageNames: ['ghul.test'],
      groupName: 'ghul.test',
      automerge: false,
    },
  ],
}
